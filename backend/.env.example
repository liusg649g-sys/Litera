# Developer-local configuration. Copy privately to backend/.env; never commit .env.
# This is NOT a store for final users' keys. Candidate endpoint is not verified.
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
# Candidate alias; verify with the synthetic probe before enabling it.
AI_MODEL=course-chat
AI_API_KEY=
AI_MODEL_VERIFIED=false
AI_MAX_OUTPUT_TOKENS=2048
# Legacy TRANSLATION_* names remain supported. AI_* takes precedence; use one set.

# User model settings: default OFF. Requires explicit additive 0008 migration
# and secure vault support (Windows DPAPI or configured external AES-GCM vault).
# This switch is not an API Key and does not verify a model.
USER_MODELS_ENABLED=false
# Dedicated user-model preview sets this to 1 to avoid developer backend/.env.
LITERA_DISABLE_DEVELOPER_MODEL=0

# User-model vault: auto keeps Windows DPAPI; Linux needs an external key file.
USER_MODEL_SECRET_BACKEND=auto
# Backend only. Never put a master-key value in this file.
USER_MODEL_MASTER_KEY_FILE=
# Optional Compose override reads this host file as a read-only secret.
USER_MODEL_MASTER_KEY_SOURCE=
