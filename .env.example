# Generate actual secrets with: python scripts/init_env.py
APP_ENV=development
APP_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SESSION_SECRET=
SESSION_TTL_SECONDS=86400
PASSWORD_MIN_LENGTH=8
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
MAX_UPLOAD_BYTES=52428800
# Container path; Compose keeps files in a private named volume.
PDF_STORAGE_ROOT=/data/pdfs
IMAGE_REGISTRY=public.ecr.aws/docker/library
