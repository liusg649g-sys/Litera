# Generate actual secrets with: python scripts/init_env.py
APP_ENV=development
APP_PORT=8085
PUBLIC_ORIGIN=http://localhost:8085
COOKIE_SECURE=false
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SESSION_SECRET=
SESSION_TTL_SECONDS=86400
PASSWORD_MIN_LENGTH=8
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
MAX_UPLOAD_BYTES=52428800
# Container path; Compose keeps files in a private named volume.
PDF_STORAGE_ROOT=/data/pdfs
IMAGE_REGISTRY=public.ecr.aws/docker/library

# Translation sends selected text to the configured external model (server-side only).
TRANSLATION_PROVIDER=openai_compatible
TRANSLATION_BASE_URL=
TRANSLATION_MODEL=
TRANSLATION_API_KEY=

# Set true only after the actual model and protocol have been privately verified.
TRANSLATION_MODEL_VERIFIED=false

# Unified developer AI settings (preferred over legacy TRANSLATION_*).
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_MODEL_VERIFIED=false
# Embedding gateway (same base URL and key; server-side only).
AI_EMBEDDING_MODEL=course-embedding
AI_EMBEDDING_DIM=2048
AI_EMBEDDING_MODEL_VERIFIED=false
# QA retrieval defaults; changing them does not change the API contract.
QA_TOP_K=8
QA_RECALL_K=30
QA_MAX_CONTEXT_CHARS=6000
QA_ANALYSIS_MAX_CHARS=12000
QA_MIN_SIMILARITY=0.25
QA_TIMEOUT_SECONDS=60
QA_INDEX_SWEEP_SECONDS=60
QA_INDEX_BATCH=32

# User-model vault: auto keeps Windows DPAPI; Linux needs an external key file.
USER_MODEL_SECRET_BACKEND=auto
# Backend only. Never put a master-key value in this file.
USER_MODEL_MASTER_KEY_FILE=
# Optional Compose override reads this host file as a read-only secret.
USER_MODEL_MASTER_KEY_SOURCE=
USER_MODELS_ENABLED=false
LITERA_DISABLE_DEVELOPER_MODEL=0
AI_MAX_OUTPUT_TOKENS=2048
